# ==========================================================================
# IMS – Internship Management System
# Copy thành .env.local (web-admin), .env (supabase/functions) và dùng trong
# Codemagic/Vercel. KHÔNG commit secret thật vào git (đã nằm trong .gitignore).
# ==========================================================================

# ---------- Web Admin (next.js) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (tuyệt đối không expose ra client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=ims@example.com
RESEND_FROM_NAME="IMS - Hệ Thống Quản Lý Thực Tập"

# Realtime → dùng khi cần server-side broadcast
SUPABASE_REALTIME_WEBHOOK_SECRET=your-rt-secret

# ---------- Admin (dùng cho seed đầu tiên ở production) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Strong_Password_123

# ---------- Firebase Cloud Messaging (server-only, dùng trong Edge Function) ----------
FCM_PROJECT_ID=your-fcm-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Certificate ----------
CERT_SIGNER_NAME="Tên Người Ký"
CERT_SIGNER_TITLE="Giám Đốc Nhân Sự"

# ---------- Mobile (Flutter) ----------
# Điền vào mobile/.env hoặc mobile/assets/config via --dart-define
# SUPABASE_URL, SUPABASE_ANON_KEY, FCM sender id...